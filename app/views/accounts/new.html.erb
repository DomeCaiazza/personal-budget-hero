<div class="w-full">
  <div class="mb-6">
    <%= link_to accounts_path, class: 'text-blue-600 hover:text-blue-800 text-sm font-medium inline-flex items-center mb-4' do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <%= t("labels.back") %>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900"><%= t("views.accounts.new.title") %></h1>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6">
    <%= form_with model: @account, local: true, class: 'space-y-6' do |f| %>
      <% if @account.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-md p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                <%= t("views.accounts.new.errors_title") %>
              </h3>
              <div class="mt-2 text-sm text-red-700">
                <ul class="list-disc pl-5 space-y-1">
                  <% @account.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div>
        <%= f.label :name, t("activerecord.attributes.account.name"), class: 'block text-sm font-medium text-gray-700 mb-2' %>
        <%= f.text_field :name, 
            class: 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500',
            placeholder: t("views.accounts.new.name_placeholder"),
            required: true %>
      </div>

      <div>
        <%= f.label :description, t("activerecord.attributes.account.description"), class: 'block text-sm font-medium text-gray-700 mb-2' %>
        <%= f.text_area :description, 
            rows: 3,
            class: 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500',
            placeholder: t("views.accounts.new.description_placeholder") %>
      </div>

      <div class="flex gap-3 pt-4">
        <%= f.submit t("labels.save"), class: 'btn btn-primary flex-1' %>
        <%= link_to t("labels.cancel"), accounts_path, class: 'btn btn-secondary flex-1' %>
      </div>
    <% end %>
  </div>
</div>

