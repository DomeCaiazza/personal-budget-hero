<div data-controller="account-switcher"
     data-account-switcher-account-id-value="<%= account.id %>">
  <div class="w-full text-left block bg-white rounded-lg shadow-md hover:shadow-lg transition-all duration-200 p-6 border border-gray-200 hover:border-blue-300 active:scale-[0.98] cursor-pointer"
       data-action="click->account-switcher#handleClick">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-6 h-6 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          <h3 class="text-lg font-semibold text-gray-900 leading-tight truncate">
            <%= account.name %>
          </h3>
        </div>
        <% if account.description.present? %>
          <p class="text-sm text-gray-600 line-clamp-2">
            <%= account.description %>
          </p>
        <% end %>
      </div>
      <div class="flex-shrink-0">
        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Modal per la scelta della versione -->
  <div data-account-switcher-target="overlay" 
       class="hidden fixed inset-0 bg-gray-500 bg-opacity-50 z-40"
       data-action="click->account-switcher#closeModal"></div>
  
  <div data-account-switcher-target="modal" 
       class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full p-6" 
         data-action="click->account-switcher#stopPropagation">
      <h3 class="text-xl font-semibold text-gray-900 mb-4"><%= t("views.accounts._account_card.modal.title") %></h3>
      <p class="text-gray-600 mb-6"><%= t("views.accounts._account_card.modal.question", account_name: account.name) %></p>
      
      <div class="flex flex-col gap-3">
        <button type="button"
                class="btn btn-primary w-full flex items-center justify-center py-3"
                data-action="click->account-switcher#selectVersion"
                data-version="console">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
          </svg>
          <%= t("views.accounts._account_card.modal.console") %>
        </button>
        
        <button type="button"
                class="btn btn-secondary w-full flex items-center justify-center py-3"
                data-action="click->account-switcher#selectVersion"
                data-version="webapp">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          <%= t("views.accounts._account_card.modal.webapp") %>
        </button>
      </div>
      
      <button type="button"
              class="mt-4 w-full text-gray-600 hover:text-gray-800 text-sm"
              data-action="click->account-switcher#closeModal">
        <%= t("views.accounts._account_card.modal.cancel") %>
      </button>
    </div>
  </div>
</div>

