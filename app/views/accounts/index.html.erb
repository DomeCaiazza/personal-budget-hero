<div class="w-full">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= t("views.accounts.index.title") %></h1>
    <%= link_to new_account_path, class: 'btn btn-primary flex items-center justify-center' do %>
      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <%= t("labels.new") %>
    <% end %>
  </div>

  <% if @accounts.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <%= render partial: 'account_card', collection: @accounts, as: :account %>
    </div>
  <% else %>
    <div class="alert alert-info text-center py-12" role="alert">
      <svg class="w-16 h-16 mx-auto mb-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
      <p class="text-gray-600 mb-4"><%= t('views.accounts.index.no_accounts') %></p>
      <%= link_to new_account_path, class: 'btn btn-primary inline-flex items-center' do %>
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <%= t("views.accounts.index.create_first_account") %>
      <% end %>
    </div>
  <% end %>
</div>

