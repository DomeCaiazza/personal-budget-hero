<% content_for :title, t("views.devise.sessions.new.title") %>
<% content_for :subtitle, t("views.devise.sessions.new.subtitle") %>

<h2 class="text-2xl font-bold text-gray-900 mb-6 text-center"><%= t("views.devise.sessions.new.title") %></h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :email, t("views.devise.sessions.new.email"), class: "form-label" %>
    <%= f.email_field :email, 
        autofocus: true, 
        autocomplete: "email",
        class: "form-control",
        placeholder: t("views.devise.sessions.new.email_placeholder"),
        required: true %>
  </div>

  <div>
    <%= f.label :password, t("views.devise.sessions.new.password"), class: "form-label" %>
    <%= f.password_field :password, 
        autocomplete: "current-password",
        class: "form-control",
        placeholder: t("views.devise.sessions.new.password_placeholder"),
        required: true %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center">
      <%= f.check_box :remember_me, 
          class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
      <%= f.label :remember_me, t("views.devise.sessions.new.remember_me"), class: "ml-2 block text-sm text-gray-900" %>
    </div>
  <% end %>

  <div>
    <%= f.submit t("views.devise.sessions.new.submit"), class: "btn btn-primary w-full" %>
  </div>
<% end %>

<div class="mt-6 text-center">
  <%= link_to t("views.devise.sessions.new.forgot_password"), new_password_path(resource_name), 
      class: "text-sm text-blue-600 hover:text-blue-800" %>
</div>

<div class="mt-4 text-center">
  <span class="text-sm text-gray-600"><%= t("views.devise.sessions.new.no_account") %> </span>
  <%= link_to t("views.devise.sessions.new.sign_up"), new_registration_path(resource_name), 
      class: "text-sm font-medium text-blue-600 hover:text-blue-800" %>
</div>

