<% content_for :title, t("views.devise.registrations.new.title") %>
<% content_for :subtitle, t("views.devise.registrations.new.subtitle") %>

<h2 class="text-2xl font-bold text-gray-900 mb-6 text-center"><%= t("views.devise.registrations.new.title") %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :email, t("views.devise.registrations.new.email"), class: "form-label" %>
    <%= f.email_field :email, 
        autofocus: true, 
        autocomplete: "email",
        class: "form-control",
        placeholder: t("views.devise.registrations.new.email_placeholder"),
        required: true %>
  </div>

  <div>
    <%= f.label :password, t("views.devise.registrations.new.password"), class: "form-label" %>
    <% if @minimum_password_length %>
      <span class="text-xs text-gray-500"><%= t("views.devise.registrations.new.password_minimum", count: @minimum_password_length) %></span>
    <% end %>
    <%= f.password_field :password, 
        autocomplete: "new-password",
        class: "form-control",
        placeholder: t("views.devise.registrations.new.password_placeholder"),
        required: true %>
  </div>

  <div>
    <%= f.label :password_confirmation, t("views.devise.registrations.new.password_confirmation"), class: "form-label" %>
    <%= f.password_field :password_confirmation, 
        autocomplete: "new-password",
        class: "form-control",
        placeholder: t("views.devise.registrations.new.password_confirmation_placeholder"),
        required: true %>
  </div>

  <div>
    <%= f.submit t("views.devise.registrations.new.submit"), class: "btn btn-primary w-full" %>
  </div>
<% end %>

<div class="mt-6 text-center">
  <span class="text-sm text-gray-600"><%= t("views.devise.registrations.new.already_account") %> </span>
  <%= link_to t("views.devise.registrations.new.sign_in"), new_session_path(resource_name), 
      class: "text-sm font-medium text-blue-600 hover:text-blue-800" %>
</div>

