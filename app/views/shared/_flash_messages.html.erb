<% flash.each do |type, message| %>
  <div class="fixed top-4 right-4 z-50 max-w-md w-full" data-controller="flash" data-transition-enter="transition ease-out duration-300" data-transition-enter-start="opacity-0 transform translate-x-full" data-transition-enter-end="opacity-100 transform translate-x-0">
    <div class="alert alert-<%= type == 'notice' ? 'success' : type == 'alert' ? 'danger' : type %> shadow-lg rounded-lg p-4 flex items-center justify-between" role="alert">
      <div class="flex-1">
        <%= raw message %>
      </div>
      <button type="button" class="ml-4 text-gray-400 hover:text-gray-600 focus:outline-none" onclick="this.closest('.fixed').remove()" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
<% end %>