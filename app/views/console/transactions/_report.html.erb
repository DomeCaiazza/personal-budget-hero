<div class="w-full bg-white shadow rounded-lg p-6 mb-6">
  <h3 class="text-lg font-semibold text-gray-900 mb-4">Financial Report</h3>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="text-sm font-medium text-red-800 mb-1">Total Expenses</div>
      <div class="text-2xl font-bold text-red-900"><%= currency_formatter(@transactions_report[:total_expenses])%></div>
    </div>
    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
      <div class="text-sm font-medium text-green-800 mb-1">Total Incomes</div>
      <div class="text-2xl font-bold text-green-900"><%= currency_formatter(@transactions_report[:total_incomes])%></div>
    </div>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <div class="text-sm font-medium text-blue-800 mb-1">Saved</div>
      <div class="text-2xl font-bold text-blue-900"><%= currency_formatter(@transactions_report[:saved]) %></div>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
      <div class="text-sm font-medium text-gray-800 mb-1">Expenses Average (Today)</div>
      <div class="text-xl font-bold text-gray-900"><%= currency_formatter(@transactions_report[:expenses_average_as_of_today]) %></div>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
      <div class="text-sm font-medium text-gray-800 mb-1">Expenses w/o Subscriptions</div>
      <div class="text-xl font-bold text-gray-900"><%= currency_formatter(@transactions_report[:expenses_without_subscriptions_average_as_of_today]) %></div>
    </div>
    <div class="bg-orange-50 border border-orange-200 rounded-lg p-4">
      <div class="text-sm font-medium text-orange-800 mb-1">Expenses Forecast</div>
      <div class="text-xl font-bold text-orange-900"><%= currency_formatter(@transactions_report[:expenses_forecast]) %></div>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
      <div class="text-sm font-medium text-gray-800 mb-1">Total Days</div>
      <div class="text-xl font-bold text-gray-900"><%= @transactions_report[:total_days].to_i %></div>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
      <div class="text-sm font-medium text-gray-800 mb-1">Passed Days</div>
      <div class="text-xl font-bold text-gray-900"><%= @transactions_report[:passed_days].to_i %></div>
    </div>
    <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
      <div class="text-sm font-medium text-purple-800 mb-1">Saving Forecast</div>
      <div class="text-xl font-bold text-purple-900"><%= currency_formatter(@transactions_report[:savings_forecast]) %></div>
    </div>
  </div>
</div>