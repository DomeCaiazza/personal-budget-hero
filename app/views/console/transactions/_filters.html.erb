<div class="w-full bg-white shadow rounded-lg p-6 mb-6">
  <h3 class="text-lg font-semibold text-gray-900 mb-4">Search Filters</h3>
  <%= search_form_for @q, url: account_console_transactions_path, html: { role: 'search', id: 'search-box', class: 'filter-active' } do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
      <div>
        <%= f.label :description_cont, Transaction.human_attribute_name(:description), class: 'form-label' %>
        <%= f.search_field :description_cont, class: 'form-control', placeholder: 'Find by description' %>
      </div>
      <div>
        <%= f.label :category_name_cont, Category.human_attribute_name(:name), class: 'form-label' %>
        <%= f.search_field :category_name_cont, class: 'form-control', placeholder: 'Find by category' %>
      </div>
      <div>
        <%= f.label :date_gteq, 'Start Date', class: 'form-label' %>
        <%= f.date_field :date_gteq, class: 'form-control', placeholder: 'Start Date' %>
      </div>
      <div>
        <%= f.label :date_lteq, 'End Date', class: 'form-label' %>
        <%= f.date_field :date_lteq, class: 'form-control', placeholder: 'End Date' %>
      </div>
    </div>
    <div class="flex flex-wrap gap-2 mb-4">
      <button type="button" data-controller="transactions" data-action="click->transactions#setMonthField" data-transactions-month="all" class="btn btn-sm btn-secondary">All</button>
      <button type="button" data-controller="transactions" data-action="click->transactions#setMonthField" data-transactions-month="last-month" class="btn btn-sm btn-secondary">Last month</button>
      <button type="button" data-controller="transactions" data-action="click->transactions#setMonthField" data-transactions-month="this-month" class="btn btn-sm btn-secondary">This month</button>
    </div>
    <div class="flex gap-2">
      <%= f.submit 'Search', class: 'btn btn-primary' %>
      <%= link_to 'Cancel', request.path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>