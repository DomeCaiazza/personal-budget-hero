<div class="w-full bg-white shadow rounded-lg p-6">
  <%= form_for [:account_console, @transaction] do |f| %>
    <% if @transaction.errors.any? %>
      <div id="error_explanation" class="alert alert-danger mb-6">
        <h2 class="font-semibold mb-2"><%= pluralize(@transaction.errors.count, "error") %>:</h2>
        <ul class="list-disc list-inside">
          <% @transaction.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :description, t('activerecord.attributes.transaction.description'), class: "form-label" %>
      <%= f.text_field :description, class: "form-control" %>
    </div>

    <div class="mb-4">
      <%= f.label :category_id, t('activerecord.attributes.transaction.category_id'), class: 'form-label' %>
      <%= f.select :category_id,
                   options_from_collection_for_select(@categories, :id, :name, selected: @transaction.category_id),
                   { include_blank: '---', required: true, default: 'q' },
                   class: 'form-control' %>
      <div class="mt-2">
        <%= link_to account_console_categories_path, class: 'text-sm text-blue-600 hover:text-blue-800' do %>
          <%= t("views.console.transactions._form.manage_categories") %>
        <% end %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :date, t('activerecord.attributes.transaction.date'), class: 'form-label' %>
      <%= f.date_field :date,
                       class: 'form-control',
                       autocomplete: 'off',
                       data: { field: :title },
                       placeholder: t("views.console.transactions._form.placeholder_description"),
                       required: true %>
      <div class="mt-2 flex gap-2">
        <button type="button" data-controller="transactions" data-action="click->transactions#setDateField" data-transactions-day="yesterday" class="btn btn-sm btn-secondary"><%= t("labels.yesterday") %></button>
        <button type="button" data-controller="transactions" data-action="click->transactions#setDateField" data-transactions-day="today" class="btn btn-sm btn-secondary"><%= t("labels.today") %></button>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :amount, class: 'form-label' %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <span class="text-gray-500 sm:text-sm">€</span>
        </div>
        <%= f.number_field :amount,
                           class: 'form-control pl-7',
                           step: '0.01',
                           required: true,
                           inputmode: 'decimal',
                           placeholder: '0.00' %>
      </div>
    </div>

    <div class="mb-4">
      <div class="flex items-center">
        <%= f.check_box :paid,
                        class: 'h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded' %>
        <%= f.label :paid, t('activerecord.attributes.transaction.paid'), class: 'ml-2 block text-sm text-gray-900' %>
      </div>
    </div>

    <div class="mb-6">
      <label class="form-label"><%= t('activerecord.attributes.transaction.transaction_type') %></label>
      <div class="mt-2 space-y-2">
        <div class="flex items-center">
          <%= f.radio_button :transaction_type, 'expense', 
              class: 'h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300', 
              required: true, 
              checked: params[:transaction_type] == "expense" || f.object.transaction_type == "expense" %>
          <%= f.label :transaction_type_expense, t('activerecord.labels.transaction.expense'), 
              class: 'ml-2 block text-sm text-gray-900' %>
        </div>
        <div class="flex items-center">
          <%= f.radio_button :transaction_type, 'income', 
              class: 'h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300', 
              required: true, 
              checked: params[:transaction_type] == "income" || f.object.transaction_type == "income" %>
          <%= f.label :transaction_type_income, t('activerecord.labels.transaction.income'), 
              class: 'ml-2 block text-sm text-gray-900' %>
        </div>
      </div>
    </div>

    <div class="flex gap-2">
      <%= f.submit @transaction.new_record? ? t('labels.save') : t('labels.update'), class: "btn btn-primary" %>
      <%= link_to t("labels.cancel"), account_console_transactions_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>
