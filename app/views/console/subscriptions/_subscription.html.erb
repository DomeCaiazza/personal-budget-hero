<tr>
  <td class="text-gray-900 font-medium"><%= subscription.description %></td>
  <td class="text-gray-900 font-semibold"><%= currency_formatter(subscription.default_amount) %></td>
  <td>
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
      <%= subscription.subscription_type %>
    </span>
  </td>
  <td>
    <div class="flex items-center justify-end gap-2">
      <%= link_to edit_account_console_subscription_path(subscription.account, subscription), 
          class: "text-blue-600 hover:text-blue-800 text-sm font-medium" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
      <% end %>
      <%= button_to account_console_subscription_path(subscription.account, subscription), 
          method: :delete, 
          class: "text-red-600 hover:text-red-800 text-sm font-medium",
          data: { confirm: 'Are you sure?' } do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      <% end %>
    </div>
  </td>
</tr>