<tr>
  <td style="background: <%= category.hex_color %>; width: 20px"></td>
  <td><%= category.name %></td>
  <td><%= category.category_type %></td>
  <td>
    <% if policy(category).edit? %>
      <div class="d-inline-block">
        <%= link_to t('labels.edit'), edit_account_console_category_path(@account, category), class: "btn btn-sm btn-link d-inline" %>
      </div>
    <% end %>
    <div class="d-inline-block">
      <%= button_to t('labels.destroy'), account_console_category_path(@account, category), method: :delete, class: "btn btn-sm btn-link d-inline" %>
    </div>
  </td>
</tr>