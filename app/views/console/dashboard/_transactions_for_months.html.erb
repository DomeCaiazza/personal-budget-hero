<div class="w-full bg-white shadow rounded-lg p-4 sm:p-6 mb-6">
  <div class="overflow-x-auto -mx-4 sm:mx-0">
    <div class="inline-block min-w-full align-middle">
      <div class="overflow-hidden">
        <table class="table min-w-full divide-y divide-gray-200">
      <thead>
        <tr>
          <th scope="col" class="w-12 sticky left-0 bg-gray-50 z-10">#</th>
          <th scope="col" class="sticky left-12 bg-gray-50 z-10 min-w-[120px]">Name</th>
          <% (1..12).each do |month| %>
            <th scope="col" class="text-center min-w-[80px]"><%= Date::MONTHNAMES[month].slice(0, 3) %></th>
          <% end %>
          <th scope="col" class="text-right min-w-[100px]">Avg</th>
          <th scope="col" class="text-right min-w-[100px]">Sum</th>
        </tr>
      </thead>
      <tbody>
        <% category_sums = [] %>
        <% @category_data.each do |category_id, data| %>
          <tr>
            <td class="sticky left-0 bg-white z-10">
              <div class="w-4 h-4 rounded-full" style="background-color: <%= data[:color] %>"></div>
            </td>
            <td class="font-medium text-gray-900 sticky left-12 bg-white z-10"><%= data[:name] %></td>
            <% data[:monthly_sums].each do |monthly_sum| %>
              <td class="text-center text-gray-700"><%= monthly_sum %></td>
            <% end %>
            <td class="text-right font-medium text-gray-900"><%= format('%.2f', data[:avg]) %></td>
            <% category_sums << format('%.2f', data[:total]) %>
            <td class="text-right font-bold text-gray-900"><%= category_sums.last %></td>
          </tr>
        <% end %>
      </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="w-full bg-white shadow rounded-lg p-6">
  <h3 class="text-lg font-semibold text-gray-900 mb-4">Distribution of Transactions by Category</h3>
  <canvas id="myChart" class="w-full"></canvas>
</div>

<script>
    var xValues = <%= @category_data.map { |_, v| v[:name] }.to_json.html_safe %>;
    var yValues = <%= @category_data.map { |_, v| v[:total] }.to_json.html_safe %>;
    var barColors = <%= @category_data.map { |_, v| v[:color] }.to_json.html_safe %>;

    new Chart("myChart", {
        type: "pie",
        data: {
            labels: xValues,
            datasets: [{
                backgroundColor: barColors,
                data: yValues
            }]
        },
        options: {
            title: {
                display: true,
                text: "Distribution of Transactions by Category"
            },
            responsive: true,
            maintainAspectRatio: true
        }
    });
</script>