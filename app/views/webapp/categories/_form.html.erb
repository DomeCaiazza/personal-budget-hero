<div class="w-full">
  <div class="bg-white shadow rounded-lg p-6">
    <%= form_for [:account_webapp, @category] do |f| %>
      <% if @category.errors.any? %>
        <div id="error_explanation" class="alert alert-danger mb-6">
          <h2 class="font-semibold mb-2"><%= pluralize(@category.errors.count, "error") %>:</h2>
          <ul class="list-disc list-inside">
            <% @category.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-6">
        <%= f.label :name, class: 'form-label' %>
        <%= f.text_field :name,
                         class: 'form-control text-lg',
                         autofocus: true,
                         required: true,
                         enterkeyhint: 'next',
                         placeholder: 'Category name' %>
      </div>

      <div class="mb-6">
        <%= f.label :hex_color, "Color", class: 'form-label' %>
        <div class="flex items-center gap-4">
          <%= f.color_field :hex_color,
                            class: 'h-16 w-20 rounded-lg border-2 border-gray-300 cursor-pointer',
                            required: true,
                            value: f.object.hex_color || Faker::Color.hex_color,
                            enterkeyhint: 'next' %>
          <div class="text-sm text-gray-500">Select a color for this category</div>
        </div>
      </div>

      <div class="mb-6">
        <label class="form-label"><%= t('activerecord.attributes.category.category_type') %></label>
        <div class="mt-2 space-y-2">
          <div class="flex items-center">
            <%= f.radio_button :category_type, 'expenses', 
                class: 'h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300', 
                required: true %>
            <%= f.label :category_type_expense, t('labels.expenses'), 
                class: 'ml-2 block text-sm text-gray-900' %>
          </div>
          <div class="flex items-center">
            <%= f.radio_button :category_type, 'incomes', 
                class: 'h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300', 
                required: true %>
            <%= f.label :category_type_income, t('labels.incomes'), 
                class: 'ml-2 block text-sm text-gray-900' %>
          </div>
        </div>
      </div>

      <div class="flex gap-2">
        <%= f.submit 'Save', class: 'btn btn-primary btn-lg flex-1' %>
        <%= link_to 'Cancel', account_webapp_categories_path(@account), class: 'btn btn-secondary btn-lg' %>
      </div>
    <% end %>
  </div>
</div>
