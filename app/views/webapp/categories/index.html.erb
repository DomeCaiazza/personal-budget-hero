<%= render 'header' %>
<div class="w-full">
  <% if @categories.any? %>
    <% if @categories.expenses.any? %>
      <h2 class="text-xl font-bold text-gray-900 mb-4">Expenses</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 mb-8">
        <%= render partial: 'webapp/categories/category_card', collection: @categories.expenses, as: :category %>
      </div>
    <% end %>
    <% if @categories.incomes.any? %>
      <h2 class="text-xl font-bold text-gray-900 mb-4">Incomes</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        <%= render partial: 'webapp/categories/category_card', collection: @categories.incomes, as: :category %>
      </div>
    <% end %>
  <% else %>
    <div class="alert alert-info text-center py-12" role="alert">
      <svg class="w-16 h-16 mx-auto mb-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
      </svg>
      <p class="text-gray-600"><%= t('labels.no_categories') %></p>
    </div>
  <% end %>
</div>