<div class="w-full">
  <div class="bg-white shadow rounded-lg p-6">
    <%= form_for [:account_webapp, @transaction] do |f| %>
      <% if @transaction.errors.any? %>
        <div id="error_explanation" class="alert alert-danger mb-6">
          <h2 class="font-semibold mb-2"><%= pluralize(@transaction.errors.count, "error") %>:</h2>
          <ul class="list-disc list-inside">
            <% @transaction.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-6">
        <%= f.label :description, t('activerecord.attributes.transaction.description'), class: 'form-label' %>
        <%= f.text_field :description,
                         class: 'form-control text-lg',
                         autofocus: true,
                         required: true,
                         enterkeyhint: 'next',
                         placeholder: t('views.webapp.transactions._form.placeholder_description') %>
      </div>

      <div class="mb-6">
        <%= f.label :category_id, t('activerecord.attributes.transaction.category_id'), class: 'form-label' %>
        <%= f.select :category_id,
                     options_from_collection_for_select(@categories, :id, :name, selected: @transaction.category_id),
                     { include_blank: '---', required: true, default: 'q' },
                     class: 'form-control text-lg' %>
        <div class="mt-2">
          <%= link_to account_webapp_categories_path(@account), 
              class: 'text-sm text-blue-600 hover:text-blue-800' do %>
            <%= t("views.webapp.transactions._form.manage_categories") %>
          <% end %>
        </div>
      </div>

      <div class="mb-6">
        <%= f.label :date, t('activerecord.attributes.transaction.date'), class: 'form-label' %>
        <%= f.date_field :date,
                         class: 'form-control text-lg',
                         autocomplete: 'off',
                         data: { field: :title },
                         placeholder: t('views.webapp.transactions._form.placeholder_date'),
                         required: true %>
        <div class="mt-2 flex gap-2">
          <button type="button" data-controller="transactions" data-action="click->transactions#setDateField" data-transactions-day="yesterday" class="btn btn-secondary btn-sm"><%= t("labels.yesterday") %></button>
          <button type="button" data-controller="transactions" data-action="click->transactions#setDateField" data-transactions-day="today" class="btn btn-secondary btn-sm"><%= t("labels.today") %></button>
        </div>
      </div>

      <div class="mb-6">
        <%= f.label :amount, t('activerecord.attributes.transaction.amount'), class: 'form-label' %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <span class="text-gray-500 text-lg">€</span>
          </div>
          <%= f.number_field :amount,
                             class: 'form-control text-lg pl-10',
                             step: '0.01',
                             required: true,
                             inputmode: 'decimal',
                             placeholder: '0.00' %>
        </div>
      </div>

      <div class="flex gap-2">
        <%= f.hidden_field :transaction_type, value: @transaction_type || f.object.transaction_type %>
        <%= f.submit t('labels.save'), class: 'btn btn-primary btn-lg flex-1' %>
        <%= link_to t('labels.cancel'), account_webapp_transactions_path(@account), class: 'btn btn-secondary btn-lg' %>
      </div>
    <% end %>
  </div>
</div>
